{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rift-cli-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "enable_request_signal",
    "request_signal_passthrough"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RIFT_CLI_RELAY",
        "class_name": "RiftCliRelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RiftCliRelayRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}

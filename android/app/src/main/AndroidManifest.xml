<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.vortex3d.app" />
        <package android:name="com.riftllm.app" />
        <package android:name="com.samsung.android.honeyboard" />
        <intent>
            <action android:name="com.riftos.runtime.EXECUTE_V1" />
        </intent>
    </queries>

    <application
        android:name=".RiftCoreApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:label="RiftOS"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.RiftOS"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".RiftBuildInstallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name=".RiftBuildInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FIRST_LAUNCH" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Experimental external DEX proof is process-isolated and non-exported;
             never started automatically or by a RAPP. -->
        <service
            android:name=".RiftBootstrapProbeService"
            android:exported="false"
            android:process=":riftBootstrapProbe"
            android:stopWithTask="true" />

        <!-- Reusable trusted DEX module host; separate process, same APK UID. -->
        <service
            android:name=".RiftGenericModuleService"
            android:exported="false"
            android:process=":riftModuleHost"
            android:stopWithTask="true" />

        <service
            android:name=".RiftNativeBufferCompilerService"
            android:exported="false"
            android:process=":riftNativeBufferCompiler"
            android:stopWithTask="false" />

        <service
            android:name=".RiftManagedJvmToolService"
            android:exported="false"
            android:process=":riftJvmToolHot"
            android:stopWithTask="false" />

        <service
            android:name=".RiftVortexAccessibilityService"
            android:exported="true"
            android:label="RiftOS Local UI Agent"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vortex_agent_accessibility" />
        </service>

        <activity
            android:name=".RiftMcpActivity"
            android:exported="true"
            android:label="Rift MCP"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="riftos" android:host="mcp" />
            </intent-filter>
        </activity>
        <provider
            android:name=".RiftCoreSurfaceIpcProvider"
            android:authorities="com.riftos.app.core-surface-ipc"
            android:exported="false"
            android:multiprocess="false" />
        <activity
            android:name=".RiftRemoteShellProbeActivity"
            android:exported="false"
            android:process=":riftShellProbe"
            android:resizeableActivity="true" />
        <activity
            android:name=".RiftAlternateGraphicalShellActivity"
            android:exported="false"
            android:resizeableActivity="true" />
        <activity
            android:name=".RiftBrowserPreviewActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- C1.3-D: actual desktop/window manager/RAPP renderer reside in
             :riftShell, NOT in Core or the read-only :riftShellProbe. -->
        <activity
            android:name=".RiftShellActivity"
            android:process=":riftShell"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Old same-process desktop remains temporarily non-launchable
             for migration compatibility; remove after D source parity. -->
        <activity android:name=".MainActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>

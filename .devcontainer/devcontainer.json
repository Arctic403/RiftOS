{
  "name": "RiftOS RiftEngine Lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "bash scripts/riftengine-codespace-setup.sh",
  "remoteEnv": {
    "RIFTENGINE_ROOT": "/workspaces/.riftengine/WebkitWasm",
    "BIB_PTHREAD": "0",
    "BIB_JOBS": "2",
    "JOBS": "2"
  }
}
